{
  "expo": {
    "name": "offer",
    "slug": "offer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/topdelz-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Topdelz to use your location to show nearby stores and deals."
        }
      ],
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.offer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Topdelz to use your location to show nearby stores and deals.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/topdelz-foreground.png",
        "backgroundImage": "./assets/topdelz-background.png",
        "monochromeImage": "./assets/topdelz-monochrome.png"
      },
      "package": "com.anonymous.offer"
    },
    "web": {
      "favicon": "./assets/topdelz-favicon.png"
    }
  }
}
