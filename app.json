{
  "expo": {
    "name": "Topdelz",
    "slug": "offer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/topdelz-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Topdelz to use your location to show nearby stores and deals."
        }
      ],
      "expo-video",
      "expo-dev-client",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebaseModularHeadersFix.js"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.topdelz.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Topdelz to use your location to show nearby stores and deals.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "10.0.2.2": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/topdelz-foreground.png",
        "backgroundImage": "./assets/topdelz-background.png",
        "monochromeImage": "./assets/topdelz-monochrome.png"
      },
      "package": "com.topdelz.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/topdelz-favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "590641c8-d056-42b3-a718-dbbc278f184d"
      }
    },
    "owner": "mcaharan11"
  }
}
